<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="movie"
            type="com.example.moviesap.data.models.MovieItem" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            app:cardCornerRadius="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView

                    android:id="@+id/iv_movie"
                    android:layout_width="70dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_rounded_main_item"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    app:imageUrl="@{movie.primaryImage}"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:src="@drawable/test"
                    />

                <TextView
                    android:id="@+id/tv_movie_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text='@{movie.primaryTitle}'
                    tools:text="movie name"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@+id/iv_movie"
                    app:layout_constraintTop_toTopOf="@+id/iv_movie" />

                <TextView
                    android:id="@+id/tv_description"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="10dp"
                    android:text='@{movie.description}'
                    tools:text="description description description description description description description description description description description description "
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/tv_movie_name"
                    app:layout_constraintTop_toBottomOf="@+id/tv_movie_name" />

                <TextView
                    android:id="@+id/tv_average_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:rating="@{movie.averageRating}"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@+id/tv_description"
                    app:layout_constraintTop_toBottomOf="@+id/tv_description"
                    tools:text="⭐9.5" />

                <TextView
                    android:id="@+id/tv_rated_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    app:votes="@{movie.numVotes}"
                    tools:text="👍 1000000"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    app:layout_constraintStart_toEndOf="@+id/tv_average_rating"
                    app:layout_constraintTop_toTopOf="@+id/tv_average_rating" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
